[sub_resource type="Shader" id="Shader_water"]
code = "shader_type spatial;
render_mode cull_disabled, depth_draw_opaque;

float hash21(vec2 p) {
 p = fract(p * vec2(123.34, 456.21));
 p += dot(p, p + 45.32);
 return fract(p.x * p.y);
}

float value_noise(vec2 p) {
 vec2 cell = floor(p);
 vec2 local = fract(p);
 local = local * local * (3.0 - 2.0 * local);
 float a = hash21(cell);
 float b = hash21(cell + vec2(1.0, 0.0));
 float c = hash21(cell + vec2(0.0, 1.0));
 float d = hash21(cell + vec2(1.0, 1.0));
 return mix(mix(a, b, local.x), mix(c, d, local.x), local.y);
}

float river_height(vec2 uv, float time) {
 // Both wave scales travel downstream (+V); only a slight lateral shear remains.
 vec2 broad_uv = uv * vec2(5.0, 13.0) + vec2(0.035, -0.22) * time;
 vec2 ripple_uv = uv * vec2(19.0, 39.0) + vec2(-0.06, -0.48) * time;
 float broad = value_noise(broad_uv) * 0.68;
 broad += sin(uv.y * 42.0 - time * 0.82 + uv.x * 6.0) * 0.16;
 float ripple = value_noise(ripple_uv) * 0.22;
 ripple += sin(uv.y * 118.0 - time * 1.7 - uv.x * 18.0) * 0.08;
 return broad + ripple;
}

void fragment() {
 float h = river_height(UV, TIME);
 float epsilon = 0.0035;
 float hx = river_height(UV + vec2(epsilon, 0.0), TIME) - river_height(UV - vec2(epsilon, 0.0), TIME);
 float hy = river_height(UV + vec2(0.0, epsilon), TIME) - river_height(UV - vec2(0.0, epsilon), TIME);

 // Center is visually deeper; both banks become subtly greener and lighter.
 float bank = smoothstep(0.23, 0.49, abs(UV.x - 0.5));
 float broad_current = value_noise(vec2(UV.x * 4.0, UV.y * 17.0 - TIME * 0.24));
 float moving_streak = sin(UV.y * 92.0 - TIME * 1.35 + value_noise(vec2(UV.x * 7.0, UV.y * 23.0 - TIME * 0.18)) * 5.0);
 moving_streak = smoothstep(0.58, 0.94, moving_streak * 0.5 + 0.5);
 vec3 deep_blue = vec3(0.012, 0.064, 0.105);
 vec3 river_blue = vec3(0.025, 0.135, 0.175);
 vec3 bank_cyan = vec3(0.055, 0.205, 0.205);
 vec3 water_color = mix(deep_blue, river_blue, clamp(h * 0.78 + 0.18, 0.0, 1.0));
 water_color = mix(water_color, bank_cyan, bank * 0.16);
 water_color += (broad_current - 0.5) * vec3(0.010, 0.032, 0.044);
 water_color += (h - 0.48) * vec3(0.018, 0.052, 0.060);
 water_color += moving_streak * vec3(0.018, 0.045, 0.050);
 float fine_ripple_color = smoothstep(0.48, 0.82, value_noise(UV * vec2(34.0, 74.0) + TIME * vec2(-0.10, 0.42)));
 water_color += fine_ripple_color * vec3(0.010, 0.030, 0.034);

 // Muted disturbance only around three authored river landmarks, never a white rim.
 float outlet = exp(-pow((UV.y - 0.448) * 30.0, 2.0));
 float collapse = exp(-pow((UV.y - 0.578) * 28.0, 2.0));
 float abandoned = exp(-pow((UV.y - 0.722) * 27.0, 2.0));
 float landmark_mask = max(outlet, max(collapse, abandoned));
 float near_playable_bank = smoothstep(0.40, 0.49, UV.x);
 float edge_breakup = near_playable_bank * landmark_mask * smoothstep(0.60, 0.88, value_noise(UV * vec2(31.0, 67.0) + TIME * vec2(0.0, 0.24)));
 water_color = mix(water_color, vec3(0.12, 0.28, 0.28), edge_breakup * 0.30);

 // Each future emergence landmark has restrained, natural-looking water behavior.
 float drain_dark = outlet * near_playable_bank * 0.12;
 water_color = mix(water_color, deep_blue * 0.78, drain_dark);
 float collapse_ripple = collapse * near_playable_bank * (sin(UV.y * 155.0 - TIME * 2.1 + UV.x * 24.0) * 0.5 + 0.5);
 water_color += collapse_ripple * vec3(0.012, 0.036, 0.042) * 0.55;
 float access_foam = abandoned * near_playable_bank * smoothstep(0.67, 0.9, value_noise(vec2(UV.x * 38.0, UV.y * 72.0 - TIME * 0.32)));
 water_color = mix(water_color, vec3(0.11, 0.25, 0.27), access_foam * 0.18);

 ALBEDO = water_color;
 EMISSION = water_color * 0.026;
 NORMAL_MAP = normalize(vec3(-hx * 5.5, -hy * 3.8, 1.0));
 NORMAL_MAP_DEPTH = 0.48;
 METALLIC = 0.0;
 ROUGHNESS = 0.62 + (1.0 - h) * 0.08;
 SPECULAR = 0.28;
}"

